<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>escsoft.MarqueeTextBlock</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Authors>Daniel Schimmelpfennig</Authors>
    <Description>Winui3 Marquee TextBlock
</Description>
    <PackageProjectUrl>https://github.com/Ruffythemonkey/escsoft.MarqueeTextBlock</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Ruffythemonkey/escsoft.MarqueeTextBlock</RepositoryUrl>
    <PackageTags>Marquee, TextBlock, WinUi3</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Page Remove="MarqueeTextBlock.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="MarqueeTextBlock.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
  </ItemGroup>
</Project>