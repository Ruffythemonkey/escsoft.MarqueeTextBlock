<?xml version="1.0" encoding="utf-8" ?>
<UserControl
	x:Class="escsoft.Controls.MarqueeTextBlock"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:escsoft.Controls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<Grid x:Name="Root">
		<Grid.Clip>
			<RectangleGeometry x:Name="ClipRect" />
		</Grid.Clip>

		<StackPanel x:Name="Panel" Orientation="Horizontal">

			<StackPanel.RenderTransform>
				<TranslateTransform x:Name="Translate" />
			</StackPanel.RenderTransform>

			<TextBlock x:Name="Text1" VerticalAlignment="Center" />

			<TextBlock x:Name="Text2" VerticalAlignment="Center" />
		</StackPanel>
	</Grid>
</UserControl>
